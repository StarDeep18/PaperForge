# =========================================================
# PaperForge Environment Configuration
# =========================================================

# Application
APP_NAME=PaperForge
APP_ENV=development # development | production
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
LOG_FORMAT=console # console (human readable) | json (structured)

# Firebase Authentication (Optional in Dev, Required in Prod)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=
REQUIRE_FIREBASE_AUTH=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost

# Database Connections
# Development (SQLite file):
DATABASE_URL=sqlite+aiosqlite:///./data/paperforge.db
# Production (PostgreSQL asyncpg):
# DATABASE_URL=postgresql+asyncpg://paperforge:paperforge_pass@postgres:5432/paperforge_db

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=paperforge_chunks
VECTOR_STORE_DISTANCE_METRIC=cosine # cosine | l2 | ip

# Google Gemini API Keys & LLM Configuration
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini # gemini | mock
LLM_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=gemini # gemini | mock
EMBEDDING_MODEL=text-embedding-004

# Document Processing & Storage
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=150

# Retrieval & Citations
TOP_K_RESULTS=8
SIMILARITY_THRESHOLD=0.3
